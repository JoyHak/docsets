<contexts>
    <context name="Normal" attribute="Normal Text" lineEndContext="#stay" fallthroughContext="Action">
        <DetectChar attribute="Comment" context="CommentLine" char=";"/>
        <Detect2Chars attribute="Comment" context="CommentBlock" char="/" char1="*" beginRegion="Comment"/>
        <keyword attribute="Directive" String="directives_actions" context="Action"  column="0"/>
        <keyword attribute="Directive" String="directives_chars" context="Directive" column="0"/>
        <RegExpr context="Hotkey" lookAhead="true" String="^[ \t]*([^ \t]+)::" column="0"/>

    </context>

    <context name="Action" attribute="Normal Text" lineEndContext="#pop">
        <DetectSpaces/>
        <AnyChar attribute="Symbol" context="Params" String="?:" firstNonSpace="1"/>
        <DetectChar attribute="Symbol" context="Statement" char="{" beginRegion="Brace1" firstNonSpace="1"/>
        <DetectChar attribute="Deref" context="Deref" char="%"/>
        <DetectChar attribute="Comment" context="CommentLine" char=";"/>
        <Detect2Chars attribute="Comment" context="CommentBlock" char="/" char1="*" beginRegion="Comment"/>
        <keyword attribute="Variable" context="#pop!Params" String="variables" />
        <keyword attribute="Hotkey" context="#pop!ActionParam" String="hotkeys"/>
        <keyword attribute="Control Flow" context="#pop!Params" String="controlflow"/>
        <keyword attribute="Break Flow" context="#pop!Params" String="breakflow"/>
        <keyword attribute="BuiltIn" context="#pop!Params" String="functions"/>
        <keyword attribute="Meta" context="#pop!Params" String="meta"/>
        <keyword attribute="Type" context="#pop!Params" String="types"/>
        <StringDetect attribute="Keyword" context="#pop!Class" String="class"/>
        <keyword attribute="Keyword" context="#pop!Function" String="keywords"/>
        <RegExpr context="Function" lookAhead="true" String="&func;"/>
        <DetectIdentifier context="#pop!Function"/>
    </context>

    <context name="Statement" attribute="Normal Text" lineEndContext="#stay">
        <DetectSpaces/>
        <AnyChar attribute="Symbol" context="Params" String="?:" firstNonSpace="1"/>
        <DetectChar attribute="Symbol" context="Statement" char="{" beginRegion="Brace1"/>
        <DetectChar attribute="Comment" context="CommentLine" char=";"/>
        <DetectChar attribute="Deref" context="Deref" char="%"/>
        <Detect2Chars attribute="Comment" context="CommentBlock" char="/" char1="*" beginRegion="Comment"/>
        <keyword attribute="Control Flow" context="Params" String="controlflow"/>
        <keyword attribute="Break Flow" context="Params" String="breakflow"/>
        <keyword attribute="Negative" context="Params" String="negatives"/>
        <keyword attribute="BuiltIn" context="Params" String="functions"/>
        <keyword attribute="Meta" context="Params" String="meta"/>
        <keyword attribute="Type" context="Params" String="types"/>
        <keyword attribute="Keyword" context="Function" String="keywords"/>
        <DetectChar attribute="Symbol" context="#pop" char="}"  endRegion="Brace1"/>
        <RegExpr context="Function" lookAhead="true" String="&func;"/>
        <DetectIdentifier context="Function"/>
    </context>

    <context name="Function" attribute="Normal Text" lineEndContext="#pop" fallthroughContext="ActionParam">
        <keyword 	attribute="Type" context="#stay" String="types"/>
        <StringDetect context="#stay" attribute="Function" String="%1" dynamic="true"/>
        <DetectSpaces/>
        <DetectChar attribute="Symbol" context="Array" char="["/>
        <keyword    attribute="Variable" String="variables" />
        <DetectChar attribute="Symbol" context="Member" char="."/>
        <DetectChar attribute="Deref"  context="Deref" char="%"/>
        <DetectChar attribute="Symbol" context="#pop!Params" char="?"/>
        <DetectChar attribute="Symbol" context="#pop!Statement" char="{" beginRegion="Brace1" />
        <Detect2Chars attribute="Symbol" context="#pop!Params" char="=" char1=">" />
        <DetectChar attribute="Symbol" context="Params" char="("/>
        <RegExpr    attribute="Symbol" context="Assignment" String="(?://|&lt;&lt;|&gt;&gt;|[-+.:/|&amp;^*%])="/>
    </context>

    <context name="Assignment" attribute="Normal Text" lineEndContext="#pop">
        <DetectSpaces/>
        <DetectChar attribute="Symbol" context="#pop#pop" char=","/>
        <DetectChar attribute="Symbol" context="Object" char="{" beginRegion="Brace1"/>
        <DetectChar attribute="Symbol" context="Array" char="["/>
        <IncludeRules context="Params"/>
    </context>

    <context name="ActionParam" attribute="Normal Text" lineEndContext="#pop">
        <DetectSpaces/>
        <DetectChar attribute="Symbol" context="#pop!Params" char="("/>
        <DetectChar attribute="Symbol" context="FuncParam" char=","/>
        <Detect2Chars attribute="Comment" context="CommentBlock" char="/" char1="*" beginRegion="Comment"/>
        <DetectChar attribute="Comment" context="CommentLine" char=";"/>
    </context>

    <context name="FuncParam" attribute="Normal Text" lineEndContext="FuncMultiLineParam">
        <DetectSpaces/>
        <DetectChar attribute="Symbol" context="#pop!MultiLineFunc" char="(" beginRegion="funcparam"/>
    </context>

    <context name="FuncMultiLineParam" attribute="Normal Text" lineEndContext="#stay" fallthroughContext="#pop#pop#pop">
        <DetectSpaces/>
        <DetectChar attribute="Symbol" context="#pop#pop!MultiLineFunc" char="(" beginRegion="funcparam"/>
    </context>

    <context name="MultiLineFunc" attribute="Normal Text" lineEndContext="#stay">
        <DetectChar attribute="Symbol" context="#pop" char=")" endRegion="funcparam"/>
    </context>

    <context name="FuncHotkey" attribute="Hotkey" lineEndContext="#pop" fallthroughContext="#pop">
        <AnyChar attribute="Hotkey" context="#stay" String="#!^+&lt;>*~$"/>
        <DetectIdentifier attribute="Hotkey" context="#pop" />
    </context>

    <context name="FuncKey" attribute="Hotkey" lineEndContext="#pop" fallthroughContext="InFuncKey">
        <Detect2Chars attribute="Normal Text" context="BraceClose" char="}" char1="}" lookAhead="true"/>
        <DetectChar attribute="Symbol" context="#pop" char="}"/>
        <AnyChar attribute="Normal Text" context="BraceClose2" String="#+^{!"/>
        <DetectSpaces/>
    </context>

    <context name="BraceClose" attribute="Normal Text" lineEndContext="#pop">
        <DetectChar attribute="Normal Text" context="#pop!BraceClose2" char="}"/>
    </context>
    <context name="BraceClose2" attribute="Normal Text" lineEndContext="#pop">
        <DetectChar attribute="Symbol" context="#pop#pop" char="}"/>
    </context>

    <context name="InFuncKey" attribute="Hotkey" lineEndContext="#pop#pop">
        <DetectSpaces/>
        <DetectIdentifier/>
        <DetectChar attribute="Symbol" context="#pop#pop" char="}"/>
    </context>

    <context name="Array" attribute="Normal Text" lineEndContext="#pop">
        <DetectSpaces/>
        <DetectChar attribute="Symbol" context="#pop" char="]"/>
        <IncludeRules context="Params"/>
    </context>

    <context name="Object" attribute="Normal Text" lineEndContext="#pop">
        <DetectSpaces/>
        <DetectChar attribute="Symbol" context="#pop" char="}" endRegion="Brace1"/>
        <IncludeRules context="Params"/>
    </context>

    <context name="Class" attribute="Normal Text" lineEndContext="#pop">
        <DetectSpaces/>
        <StringDetect attribute="Keyword" String="extends"/>
        <DetectIdentifier attribute="Type"/>
        <DetectChar attribute="Type" char="."/>
        <DetectChar attribute="Symbol" context="#pop!Statement" char="{" beginRegion="Brace1"/>
    </context>

    <context name="Params" attribute="Normal Text" lineEndContext="#pop">
        <DetectChar attribute="Comment" context="CommentLine" char=";"/>
        <Detect2Chars attribute="Symbol" context="Regex" char="~" char1="="/>
        <DetectChar attribute="String" context="String" char="&quot;"/>
        <DetectChar attribute="String Char" context="String Char" char="'"/>
		<keyword attribute="Control Flow" context="#stay" String="controlflow"/>
        <keyword attribute="Negative" context="#stay" String="negatives"/>
        <keyword attribute="BuiltIn" context="#stay" String="functions"/>
        <keyword attribute="Meta" context="#stay" String="meta"/>
        <keyword attribute="Type" context="#stay" String="types"/>
        <RegExpr attribute="Symbol" String="&operator;"/>
        <keyword attribute="Variable" context="#stay" String="variables" />
        <DetectChar attribute="Symbol" context="Member" char="."/>
        <Float attribute="Float" context="#stay"/>
        <HlCHex attribute="Hex" context="#stay"/>
        <Int attribute="Decimal" context="#stay"/>
        <RegExpr context="Function" lookAhead="true" String="&func;"/>
        <DetectChar attribute="Symbol" context="Params" char="("/>
        <DetectChar attribute="Symbol" context="#pop" char=")"/>
        <DetectChar attribute="Symbol" context="Statement" char="{" beginRegion="Brace1"/>
        <Detect2Chars attribute="Comment" context="CommentBlock" char="/" char1="*" beginRegion="Comment"/>
        <DetectChar attribute="Deref" context="Deref" char="%"/>
        <AnyChar attribute="Symbol" context="#stay" String=":!&amp;+,-/.*&lt;&gt;=?[]|~^"/>
    </context>

    <context name="Member" attribute="Normal Text" lineEndContext="#pop" fallthroughContext="#pop">
        <DetectChar context="#pop" char=" "/>
        <DetectSpaces/>
        <keyword attribute="Type" context="#pop" String="types"/>
        <keyword attribute="Meta" context="#pop" String="meta"/>
        <RegExpr context="Function" lookAhead="true" String="&func;"/>
        <DetectIdentifier attribute="Normal Text" context="#pop"/>
    </context>

    <context name="Directive" attribute="Meta" lineEndContext="#pop">
        <Detect2Chars attribute="Comment" context="CommentBlock" char="/" char1="*" beginRegion="Comment"/>
        <DetectChar attribute="Comment" context="CommentLine" char=";"/>
    </context>

    <context name="Regex" attribute="Regex" lineEndContext="#pop">
        <DetectSpaces/>
        <AnyChar context="#stay" String="&quot;'"/>
        <RegExpr attribute="Regex Option" String="[imsxADJUXSC]+\)" insensitive="false"/>
        <IncludeRules context="InSubRegex"/>
    </context>

    <context name="InSubRegex" attribute="Regex" lineEndContext="#pop#pop">
        <RegExpr attribute="Regex Keyword" String="\\[nrt0aefVvWwDdXxpCckg#]" insensitive="false"/>
        <RegExpr attribute="Symbol" String="\\[QEGKBbAZ]" insensitive="false"/>
        <RegExpr attribute="Decimal" String="[\\$]\d"/>
        <DetectChar attribute="Regex Escaped" context="RegexChar" char="\"/>
        <DetectChar attribute="Regex Escaped" context="RegexChar" char="`"/>
        <AnyChar attribute="Regex" context="#pop#pop" String="&quot;'"/>
        <DetectChar attribute="Regex Group" context="SubRegex" char="("/>
        <DetectChar attribute="Regex Group" context="#pop#pop" char=")"/>
        <DetectChar attribute="Regex Group" context="RegexChars" char="["/>
        <AnyChar attribute="Symbol" context="#stay" String="?+*{}.|^$"/>
    </context>

    <context name="SubRegex" attribute="Regex Group" lineEndContext="#pop" fallthroughContext="InSubRegex">
        <DetectChar context="#pop!SubRegexCmd" char="?"/>
        <DetectChar context="#pop!RegKeyword" char="*"/>
    </context>

    <context name="SubRegexCmd" attribute="Regex Group" lineEndContext="#pop">
        <DetectChar attribute="Decimal" context="#stay" char="+"/>
        <Int attribute="Decimal" context="#pop!RegKeyword"/>
        <DetectChar attribute="Regex Keyword" context="#pop!RegKeyword" char="R"/>
        <Detect2Chars attribute="Regex Positive" context="InSubRegex" char="&lt;" char1="="/>
        <Detect2Chars attribute="Regex Negative" context="InSubRegex" char="&lt;" char1="!"/>
        <DetectChar attribute="Regex Label" context="#pop!RegLabel" char="&lt;"/>
        <DetectChar context="#pop!RegKeyword" char="&amp;"/>
        <DetectChar context="#pop!RegComment" char="#"/>
        <DetectChar attribute="Regex Negative" context="InSubRegex" char="!"/>
        <DetectChar attribute="Regex Positive" context="InSubRegex" char="="/>
        <DetectChar context="InSubRegex" char=":"/>
    </context>

    <context name="RegLabel" attribute="Regex Label" lineEndContext="#pop" fallthroughContext="InSubRegex">
        <DetectIdentifier/>
        <DetectChar context="InSubRegex" char="&gt;"/>
    </context>

    <context name="RegKeyword" attribute="Regex Label" lineEndContext="#pop">
        <DetectIdentifier/>
        <DetectChar attribute="Regex Group" context="#pop" char=")"/>
    </context>

    <context name="RegComment" attribute="Comment" lineEndContext="#pop">
        <DetectIdentifier/>
        <DetectChar context="#pop" char=")"/>
    </context>

    <context name="RegexChars" attribute="Regex" lineEndContext="#pop" fallthroughContext="InRegexChars">
        <DetectChar attribute="Regex Negative" context="#pop!InRegexChars" char="^"/>
        <DetectChar attribute="Regex Group" context="InRegexChars" char="]"/>
    </context>

    <context name="InRegexChars" attribute="Regex Char" lineEndContext="#pop#pop">
        <DetectChar attribute="Regex Group" context="#pop#pop" char="]"/>
        <DetectChar attribute="Regex Char" context="RegexClass" char="["/>
        <DetectChar attribute="Regex Escaped" context="RegexChar" char="\"/>
        <DetectChar attribute="Regex Escaped" context="RegexChar" char="`"/>
    </context>

    <context name="RegexClass" attribute="Regex Char" lineEndContext="#pop">
        <DetectChar attribute="Regex Char" context="#pop" char="]"/>
    </context>

    <context name="RegexChar" attribute="Regex Escaped" lineEndContext="#pop">
        <RegExpr context="#pop" String="." />
    </context>

    <context name="Deref" attribute="Deref" lineEndContext="#pop" fallthroughContext="#pop">
        <DetectIdentifier/>
        <DetectChar attribute="Deref" context="#pop" char="%"/>
    </context>

    <context name="Hotkey" attribute="Normal Text" lineEndContext="#pop">
        <StringDetect attribute="Hotkey" context="#stay"  String="%1" dynamic="true"/>
        <Detect2Chars attribute="Symbol" context="#stay" char=":" char1=":" />
        <IncludeRules context="Function" />
        <RegExpr attribute="Hotkey" context="#pop" String="[^ \t]+"/>
        <DetectSpaces/>
        <DetectChar attribute="Comment" context="CommentLine" char=";"/>
        <Detect2Chars attribute="Comment" context="CommentBlock" char="/" char1="*" beginRegion="Comment"/>
    </context>

    <context name="Hotstring" attribute="Normal Text" lineEndContext="#pop">
        <AnyChar attribute="Symbol" context="#stay" String=":?*"/>
        <DetectSpaces/>
        <DetectChar attribute="Comment" context="CommentLine" char=";"/>
        <Detect2Chars attribute="Comment" context="CommentBlock" char="/" char1="*" beginRegion="Comment"/>
    </context>

    <context name="String" attribute="String" lineEndContext="#pop">
        <RegExpr attribute="Regex Option" context="Regex" String="[imsxADJUXSC]+\)" insensitive="false"/>
        <LineContinue attribute="String" context="#stay"/>
        <DetectChar attribute="String Char" context="EscapeString" char="`" />
        <Detect2Chars attribute="String Char" context="#stay" char="&quot;" char1="&quot;" />
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
    </context>

    <context name="String Char" attribute="String Char" lineEndContext="#pop">
        <RegExpr attribute="Regex Option" context="Regex" String="[imsxADJUXSC]+\)" insensitive="false"/>
        <LineContinue attribute="String Char" context="#stay"/>
        <DetectChar attribute="String" context="EscapeString" char="`" />
        <Detect2Chars attribute="String Char" context="#stay" char="'" char1="'" />
        <DetectChar attribute="String Char" context="#pop" char="'"/>
    </context>

    <context name="EscapeString" attribute="String Char" lineEndContext="#pop" fallthroughContext="#pop">
        <Detect2Chars attribute="String Char" context="#stay" char=":" char1=":" />
        <AnyChar attribute="String Char" context="#pop" String="`,%;nrbtvaf&apos;&quot;"/>
    </context>

    <context name="CommentLine" attribute="Comment" lineEndContext="#pop">
        <DetectSpaces />
        <IncludeRules context="##Comments" />
        <DetectIdentifier />
    </context>

    <context name="CommentBlock" attribute="Comment" lineEndContext="#stay">
        <DetectSpaces />
        <Detect2Chars attribute="Comment" context="#pop" char="*" char1="/" endRegion="Comment"/>
        <IncludeRules context="##Comments" />
        <DetectIdentifier />
    </context>

</contexts>
